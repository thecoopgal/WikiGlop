# Copy this file to ".env" in the project root and fill in your key.
# Restart the dev server after changing .env (npm run dev).

# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Cloudflare Workers / production: set the secret with
#   wrangler secret put RESEND_API_KEY
# (overrides the empty RESEND_API_KEY var in wrangler.jsonc)

# Optional: "Name <email@your-verified-domain>" — default uses Resend's test sender
# FORM_EMAIL_FROM=

# Email address that receives new Links creator page submissions
# LINKS_CREATE_SUBMIT_EMAIL=you@example.com
